{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.Extensions.AI": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "documind": "Host=localhost;Port=5432;Database=documind;Username=postgres;Password=postgres",
    "qdrant": "Endpoint=http://localhost:6334",
    "ollama": "Endpoint=http://localhost:11434"
  },
  "Jwt": {
    "Issuer": "documind",
    "Audience": "documind",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Storage": {
    "Root": "../../.data/uploads"
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "Database": {
    "AutoMigrate": true
  },
  "Seed": {
    "Enabled": false
  },
  "AI": {
    "ChatProvider": "ollama",
    "EmbeddingProvider": "ollama",
    "ChatModel": "llama3.2:3b",
    "EmbeddingModel": "nomic-embed-text",
    "DocumentPrefix": "search_document: ",
    "QueryPrefix": "search_query: ",
    "ContextTokenBudget": 3500,
    "OpenAI": { "ApiKey": "", "Endpoint": "" },
    "Anthropic": { "ApiKey": "" },
    "Pricing": {
      "gpt-4.1-mini": { "InputPerMillion": 0.4, "OutputPerMillion": 1.6 },
      "gpt-4.1": { "InputPerMillion": 2.0, "OutputPerMillion": 8.0 },
      "claude-sonnet-5-5": { "InputPerMillion": 3.0, "OutputPerMillion": 15.0 },
      "claude-haiku-5-5": { "InputPerMillion": 1.0, "OutputPerMillion": 5.0 }
    }
  }
}
